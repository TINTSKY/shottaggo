{
  "name": "dsh-annotate-viewport",
  "version": "0.1.0",
  "private": true,
  "description": "Full-viewport screenshots with numbered red boxes and comments, inserted into the Harness composer as image drafts.",
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/capture.test.cjs test/lib.test.cjs test/package.test.cjs test/region.test.cjs",
    "test:harness": "node test/harness/run.cjs",
    "test:bench": "node test/bench/run.cjs",
    "check": "npm run build && npm test && node --check client.js"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "html-to-image": "^1.11.13"
  },
  "license": "MIT"
}
